# --- Base de datos Supabase ---
# Supabase > Project Settings > Database > Connection string > URI
# Usa Transaction pooler (puerto 6543) para Vercel/serverless.
# Formato: postgresql+psycopg://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres.XXXXXX:TU_CONTRASENA@aws-0-XX.pooler.supabase.com:6543/postgres?sslmode=require

# --- Seguridad JWT ---
# Genera: openssl rand -hex 32
SECRET_KEY=genera_una_clave_secreta_larga
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Admin inicial (python -m app.seed) ---
ADMIN_EMAIL=admin@keremspa.com
ADMIN_PASSWORD=CambiaEstaClave123!
ADMIN_NAME=Administrador KEREM

# --- Agenda ---
AGENDA_START=09:00
AGENDA_END=20:00
AGENDA_STEP_MINUTES=30
AGENDA_LUNCH_START=13:00
AGENDA_LUNCH_END=14:00

# --- SMTP (opcional) ---
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=KEREM Spa <no-reply@keremspa.com>
MAIL_USE_TLS=true

# --- Google OAuth (opcional) ---
# En producción agrega: https://TU-DOMINIO.vercel.app/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://TU-DOMINIO.vercel.app/auth/google/callback
